<!doctype html>
<html lang="hi-Latn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if pageTitle %}{{ pageTitle }} — {{ site.title }}{% else %}{{ site.title }} — Kavitaien by {{ site.author }}{% endif %}</title>
<meta name="description" content="{{ pageDescription or site.description }}">
<meta name="author" content="{{ site.author }}">
<meta name="google-site-verification" content="g33H23ha3BicTFA5eHAnBxUX4VokPtLDQ_cBT1_iHzg">
<link rel="canonical" href="{{ page.url | url | absolute(meta.url) }}">

<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ pageTitle or site.title }}">
<meta property="og:description" content="{{ pageDescription or site.description }}">
<meta property="og:url" content="{{ page.url | url | absolute(meta.url) }}">
<meta name="twitter:card" content="summary">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..600&family=Spectral:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Karla:wght@400;500;600&display=swap">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
<link rel="icon" href="{{ '/assets/favicon.svg' | url }}" type="image/svg+xml">
</head>
<body>
<a class="skip" href="#main">Content par jaayein</a>

<div class="page">
  <header class="masthead {{ 'masthead--compact' if compactHeader }}">
    <p class="eyebrow">Kavita · Ghazal · Shayari</p>
    <h1 class="wordmark"><a href="{{ '/' | url }}">Kavi <em>Kehna</em> Chahte Hain</a></h1>
    <div class="orn"><span>&#10087;</span></div>
    {% if not compactHeader %}
      <p class="tagline">{{ site.tagline }}</p>
      <p class="sig">&mdash; {{ site.author }}</p>
    {% endif %}
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="colophon">
    <span>{{ site.title }} &middot; sab kavitaien {{ site.author }} ki</span>
    <span class="colophon-links">
      <a href="{{ '/' | url }}">Kavitaien</a>
      <a href="{{ '/kavi/' | url }}">Kavi</a>
      {% set footerInsta = site.instagram_poetry or site.instagram %}
      {% if footerInsta %}<a href="https://instagram.com/{{ footerInsta }}" rel="me noopener" target="_blank">Instagram</a>{% endif %}
    </span>
  </footer>
</div>
</body>
</html>
